fest if m[\"status\"] == \"success\" and m[\"coverage\"] is not None]\n","ok_list.sort(key=lambda x: x[\"coverage\"])\n","\n","if ok_list:\n","    n = min(3, len(ok_list))\n","    groups = {\n","        \"low_prediction_coverage\": ok_list[:n],\n","        \"median_prediction_coverage\": ok_list[max(0, len(ok_list)//2 - n//2):][:n],\n","        \"high_prediction_coverage\": ok_list[-n:]\n","    }\n","    lookup = {r[\"image_id\"]: r for r in page_list}\n","    for group, items in groups.items():\n","        for item in items:\n","            rec = lookup[item[\"image_id\"]]\n","            _, aligned = load_and_align(rec[\"image_path\"])\n","            mask = cv2.imread(str(DELIVERABLE_ROOT / item[\"mask\"]), cv2.IMREAD_GRAYSCALE)\n","            overlay = aligned.copy()\n","            overlay[mask == 255] = (0.35 * overlay[mask == 255] + 0.65 * np.array([255, 0, 0], dtype=np.float32)).astype(np.uint8)\n","            fig, ax = plt.subplots(1, 3, figsize=(16, 6))\n","            ax[0].imshow(aligned)\n","            ax[0].set_title(\"Aligned Original\")\n","            ax[1].imshow(mask, cmap=\"gray\")\n","            ax[1].set_title(\"Prediction Mask\")\n","            ax[2].imshow(overlay)\n","            ax[2].set_title(\"Prediction Overlay\")\n","            for a in ax: a.axis(\"off\")\n","            fig.suptitle(f\"{item['image_id']} | {group} | coverage={item['coverage']:.4f}\")\n","            fig.tight_layout()\n","            out_file = FIG_DIR / group / f\"{item['image_id'].replace('/', '__')}.png\"\n","            out_file.parent.mkdir(parents=True, exist_ok=True)\n","            fig.savefig(out_file, dpi=100, bbox_inches=\"tight\")\n","            plt.close(fig)\n","\n","print(\"Visualizations đã lưu tại:\", FIG_DIR)"],"metadata":{"id":"sVQ8qQXoFuX_","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1790333605055,"user_tz":-420,"elapsed":8764,"user":{"displayName":"Phạm Quốc","userId":"14243905189799001759"}},"outputId":"8e8011d3-afb0-4422-a809-4ff0804843a0"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Visualizations đã lưu tại: /content/drive/MyDrive/DIP/deliverables/unetpp-efficientnetv2/visualizations\n"]}]},{"cell_type":"code","source":["# [Cell 16] Tự kiểm tra đối soát trực tiếp theo đúng 7 checks của FR-058\n","pl = json.loads(PAGE_LIST_FILE.read_text(encoding=\"utf-8\"))\n","idr = json.loads(IMAGE_ID_FILE.read_text(encoding=\"utf-8\"))\n","W, H = pl[\"aligned_size\"]\n","REQ = (\"method\", \"repository\", \"checkpoint\", \"code_license\", \"weight_license\",\n","       \"checkpoint_load_evidence\", \"device\", \"interpreter\", \"packages\", \"seed\", \"run_timestamp\")\n","\n","def selfcheck(handoff_dir):\n","    h = Path(handoff_dir)\n","    bad = []\n","\n","    # 1. Kiểm tra provenance.json\n","    prov = h / \"provenance.json\"\n","    if not prov.is_file():\n","        bad.append(\"check5: Thiếu provenance.json ở gốc hand-off\")\n","    else:\n","        p_json = json.loads(prov.read_text(encoding=\"utf-8\"))\n","        miss = [k for k in REQ if k not in p_json]\n","        if miss:\n","            bad.append(f\"check5: provenance thiếu key: {miss}\")\n","        if p_json.get(\"method\") != \"unetpp-efficientnetv2\":\n","            bad.append(f\"check5: method '{p_json.get('method')}' không phải 'unetpp-efficientnetv2'\")\n","        if p_json.get(\"code_license\") != \"none\":\n","            bad.append(\"check5: code_license phải là 'none'\")\n","        if p_json.get(\"repository\", {}).get(\"url\", \"\").endswith(\".git\"):\n","            bad.append(\"check5: repository URL không được chứa '.git'\")\n","\n","    # 2. Kiểm tra từng trang trong danh sách 390 trang\n","    for page in pl[\"pages\"]:\n","        iid = page[\"image_id\"]\n","        manga = page[\"manga\"]\n","        stem = page[\"stem\"]\n","\n","        sc = h / \"metadata\" / manga / f\"{stem}.json\"\n","        if not sc.is_file():\n","            bad.append(f\"check1: Thiếu sidecar {iid}\")\n","            continue\n","\n","        s = json.loads(sc.read_text(encoding=\"utf-8\"))\n","        if s.get(\"page_list_identity\") != pl[\"page_list_identity\"]:\n","            bad.append(f\"check1: {iid} page_list_identity sai\")\n","        if s.get(\"input_image_identity\") != idr[iid][\"sha256\"]:\n","            bad.append(f\"check2: {iid} input_image_identity sai\")\n","        if s.get(\"input_size\") != [W, H] or s.get(\"output_size\") != [W, H]:\n","            bad.append(f\"check1: {iid} input_size/output_size bị đảo, phải là [1654, 1170]\")\n","\n","        mp = h / \"masks\" / manga / f\"{stem}.png\"\n","        m = cv2.imread(str(mp), cv2.IMREAD_UNCHANGED)\n","        if m is None:\n","            bad.append(f\"check3: {iid} thiếu file mask\")\n","            continue\n","        if m.ndim != 2 or m.dtype != np.uint8:\n","            bad.append(f\"check3: {iid} mask không phải single-channel uint8\")\n","        elif m.shape != (H, W):\n","            bad.append(f\"check3: {iid} mask shape {m.shape} != {(H, W)}\")\n","        elif not set(np.unique(m).tolist()) <= {0, 255}:\n","            bad.append(f\"check4: {iid} mask chứa giá trị ngoài {{0, 255}}\")\n","\n","    got = {f\"{d.name}/{f.stem}\" for d in (h / \"masks\").iterdir() if d.is_dir() for f in d.glob(\"*.png\")}\n","    want = {p[\"image_id\"] for p in pl[\"pages\"]}\n","    if got - want:\n","        bad.append(f\"Thừa {len(got - want)} mask ngoài danh sách (vd {sorted(got - want)[:2]})\")\n","    if want - got:\n","        bad.append(f\"Thiếu {len(want - got)} mask (vd {sorted(want - got)[:2]})\")\n","\n","    return bad\n","\n","issues = selfcheck(DELIVERABLE_ROOT)\n","if not issues:\n","    print(\"=\" * 75)\n","    print(\">>> CHÚC MỪNG: HAND-OFF TRÊN GOOGLE DRIVE ĐÃ ĐẠT 100% TIÊU CHUẨN (PASS FR-058)!\")\n","    print(\"=\" * 75)\n","else:\n","    print(f\"CẦN SỬA {len(issues)} LỖI:\")\n","    for err in issues[:20]:\n","        print(\" [!] \", err)"],"metadata":{"id":"c6xThwGCFwij","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1790333725203,"user_tz":-420,"elapsed":22701,"user":{"displayName":"Phạm Quốc","userId":"14243905189799001759"}},"outputId":"33b8ad99-2f6c-4ed7-89ca-1778ef5028da"},"execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["===========================================================================\n",">>> CHÚC MỪNG: HAND-OFF TRÊN GOOGLE DRIVE ĐÃ ĐẠT 100% TIÊU CHUẨN (PASS FR-058)!\n","===========================================================================\n"]}]}]}