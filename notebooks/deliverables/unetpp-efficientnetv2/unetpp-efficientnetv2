  \"error\": err\n","    }\n","    jp.write_text(json.dumps(side, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n","    manifest.append({\n","        \"image_id\": image_id,\n","        \"status\": status,\n","        \"mask\": str(mp.relative_to(DELIVERABLE_ROOT)) if status == \"success\" else None,\n","        \"metadata\": str(jp.relative_to(DELIVERABLE_ROOT)),\n","        \"coverage\": coverage,\n","        \"inference_time_seconds\": inf\n","    })\n","    if idx % 50 == 0 or idx == len(page_list):\n","        print(f\"[{idx:>3}/390] {image_id} | {status} | inf={inf:.3f}s\")\n","\n","total_time = time.perf_counter() - start_total\n","print(f\"HOÀN THÀNH: 390 trang | Thành công: {sum(x['status'] == 'success' for x in manifest)} | Lỗi: {len(errors)}\")"],"metadata":{"id":"Mqd0P-qFD-PN","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1790333596242,"user_tz":-420,"elapsed":161637,"user":{"displayName":"Phạm Quốc","userId":"14243905189799001759"}},"outputId":"78523722-a651-4e85-9ad5-15ac8d4e1f79"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Bắt đầu suy luận và lưu kết quả vào Drive: /content/drive/MyDrive/DIP/deliverables/unetpp-efficientnetv2\n","[ 50/390] AosugiruHaru/009 | success | inf=0.261s\n","[100/390] BurariTessenTorimonocho/009 | success | inf=0.265s\n","[150/390] EienNoWith/009 | success | inf=0.269s\n","[200/390] GinNoChimera/009 | success | inf=0.276s\n","[250/390] HealingPlanet/009 | success | inf=0.281s\n","[300/390] UchuKigekiM774/009 | success | inf=0.297s\n","[350/390] YasasiiAkuma/009 | success | inf=0.298s\n","[390/390] YumeiroCooking/009 | success | inf=0.302s\n","HOÀN THÀNH: 390 trang | Thành công: 390 | Lỗi: 0\n"]}]},{"cell_type":"code","source":["# [Cell 13] Tạo provenance.json tại gốc hand-off trên Drive với key checkpoint 'identity'[cite: 3]\n","provenance_obj = {\n","    \"method\": METHOD_NAME,\n","    \"repository\": {\n","        \"url\": REPOSITORY,\n",