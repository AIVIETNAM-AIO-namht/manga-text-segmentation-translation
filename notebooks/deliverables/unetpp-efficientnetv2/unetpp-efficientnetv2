":["WARNING:timm.models._builder:Unexpected keys (bn2.num_batches_tracked, bn2.bias, bn2.running_mean, bn2.running_var, bn2.weight, classifier.bias, classifier.weight, conv_head.weight) found while loading pretrained weights. This may be expected if model is being adapted.\n"]},{"output_type":"stream","name":"stdout","text":["Đã nạp model thành công với strict=True!\n"]}]},{"cell_type":"code","source":["# [Cell 8] Tạo bằng chứng nạp trọng số dương đúng chuẩn FR-018a/b[cite: 3, 4]\n","def sha256_file(path, chunk_size=1<<20):\n","    h = hashlib.sha256()\n","    with open(path, \"rb\") as f:\n","        while True:\n","            b = f.read(chunk_size)\n","            if not b: break\n","            h.update(b)\n","    return h.hexdigest()\n","\n","def sha256_bytes(data):\n","    return hashlib.sha256(data).hexdigest()\n","\n","CKPT_SHA256 = sha256_file(MODEL_PATH)\n","msd = model.state_dict()\n","\n","missing = sorted(set(state_dict.keys()) - set(msd.keys()))\n","unexpected = sorted(set(msd.keys()) - set(state_dict.keys()))\n","\n","checked = exact = 0\n","for k, v in state_dict.items():\n","    if k in msd:\n","        checked += 1\n","        if torch.equal(msd[k].detach().cpu().float(), v.detach().cpu().float()):\n","            exact += 1\n","\n","strict_load_ok = (len(missing) == 0 and len(unexpected) == 0 and checked == exact)\n","\n","fp = hashlib.sha256()\n","for k in sorted(msd):\n","    fp.update(k.encode())\n","    fp.update(msd[k].detach().cpu().float().numpy().tobytes())\n","PARAM_FINGERPRINT = fp.hexdigest()\n","\n","with torch.no_grad():\n","    g = torch.Generator().manual_seed(SEED)\n","    probe = torch.randn(1, 3, 64, 64, generator=g).to(DEVICE)\n","    probe_out = model(probe).float().cpu().numpy()\n","PROBE_CHECKSUM = sha256_bytes(np.ascontiguousarray(probe_out).tobytes())\n","\n","CHECKPOINT_INFO = {\n","    \"name\": MODEL_PATH.name,\n","    \"source\": \"huggingface:a-b-c-x-y-z/Manga-Text-Segmentation-2025/model.pth\",\n","    \"size_bytes\": CKPT_SIZE_BYTES,\n","    \"sha256\": CKPT_SHA256,\n","    \"loaded_evidence\": {\n","        \"strict_load_ok\": strict_load_ok,\n","        \"checkpoint_state_dict_keys\": len(state_dict),\n","        \"model_state_dict_keys\": len(msd),\n","        \"keys_compared\": checked,\n","        \"keys_bitwise_identical\": exact,\n","        \"missing_keys\": missing,\n","        \"unexpected_keys\": unexpected,\n","        \"loaded_param_fingerprint_sha256\": PARAM_FINGERPRINT,\n","        \"fixed_probe_output_sha256\": PROBE_CHECKSUM\n","    },\n","    \"weight_license\": WEIGHT_LICENSE\n","}\n","\n","assert strict_load_ok, \"Lỗi: Trọng số nạp không khớp bitwise 100%!\"\n","print(\"Checkpoint SHA256:\", CKPT_SHA256)\n","print(\"Bằng chứng nạp trọng số dương:\", strict_load_ok)"],"metadata":{"id":"bAobehjwCwK7","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1790333429270,"user_tz":-420,"elapsed":3166,"user":{"displayName":"Phạm Quốc","userId":"14243905189799001759"}},"outputId":"92507e9b-b9ac-43c1-dc5d-00b7aa20ec3c"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Checkpoint SHA256: a0a895dc385608554a81ca765b0c62d654462c2bac661abdff63634985ab37fc\n","Bằng chứng nạp trọng số dương: True\n"]}]},{"cell_type":"code","source":["# [Cell 9] Hàm tiền xử lý & suy luận (Crop-topleft 1654x1170, không resize)[cite: 2]\n","transform = A.Compose([\n","    A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),\n","    ToTensorV2()\n","])\n","\n","def load_and_align(path):\n","    bgr = cv2.imread(str(path), cv2.IMREAD_COLOR)\n","    if bgr is None:\n","        raise IOError(f\"Không thể đọc ảnh: {path}\")\n","    rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)\n","    h, w = rgb.shape[:2]\n","    if h < TARGET_HEIGHT or w < TARGET_WIDTH:\n","        raise ValueError(f\"Ảnh {w}x{h} nhỏ hơn kích thước chuẩn {TARGET_WIDTH}x{TARGET_HEIGHT}\")\n","    # Cắt top-left 1170x1654, tuyệt đối không resize ảnh[cite: 2]\n","    return rgb, rgb[:TARGET_HEIGHT, :TARGET_WIDTH]\n","\n","def predict(aligned):\n","    t0 = time.perf_counter()\n","    tensor = transform(image=aligned)[\"image\"].unsqueeze(0).to(DEVICE)\n","    ph = (PAD_MULTIPLE - TARGET_HEIGHT % PAD_MULTIPLE) % PAD_MULTIPLE\n","    pw = (PAD_MULTIPLE - TARGET_WIDTH % PAD_MULTIPLE) % PAD_MULTIPLE\n","    if ph or pw:\n","        tensor = F.pad(tensor, (0, pw, 0, ph), mode=\"constant\", value=0)\n","    pre_time = time.perf_counter() - t0\n","\n","    if DEVICE.type == \"cuda\":\n","        torch.cuda.synchronize()\n","    t1 = time.perf_counter()\n","    with torch.no_grad():\n","        if DEVICE.type == \"cuda\":\n","            with torch.autocast(device_type=\"cuda\", dtype=torch.float16):\n","                logits = model(tensor)\n","        else:\n","            logits = model(tensor)\n","    if DEVICE.type == \"cuda\":\n","        torch.cuda.synchronize()\n","    inf_time = time.perf_counter() - t1\n","\n","    t2 = time.perf_counter()\n","    prob = torch.sigmoid(logits)[0, 0, :TARGET_HEIGHT, :TARGET_WIDTH].float().cpu().numpy()\n","    mask = (prob >= THRESHOLD).astype(np.uint8) * 255\n","\n","    # Kiểm tra ràng buộc định dạng mask của Spec 001/002[cite: 2, 4]\n","    assert mask.shape == (TARGET_HEIGHT, TARGET_WIDTH)\n","    assert mask.dtype == np.uint8\n","    assert set(np.unique(mask)).issubset({0, 255})\n","    post_time = time.perf_counter() - t2\n","\n","    return mask, pre_time, inf_time, post_time"],"metadata":{"id":"ugSmuH5HC1F_","executionInfo":{"status":"ok","timestamp":1790333429277,"user_tz":-420,"elapsed":4,"user":{"displayName":"Phạm Quốc","userId":"14243905189799001759"}}},"execution_count":11,"outputs":[]},{"cell_type":"code","source":["# [Cell 10] Chạy thử nghiệm smoke test trên 2 trang đầu\n","smoke = []\n","for rec in page_list[:2]:\n","    _, aligned = load_and_align(rec[\"image_path\"])\n","    m, a, b, c = predict(aligned)\n","    smoke.append({\n","        \"image_id\": rec[\"image_id\"],\n","        \"shape\": list(m.shape),\n","        \"dtype\": str(m.dtype),\n","        \"unique\": np.unique(m).tolist(),\n","        \"inference_sec\": round(b, 4)\n","    })\n","print(json.dumps(smoke, indent=2))\n","print(\"Smoke test PASS thành công!\")"],"metadata":{"id":"1q_wzZ0Xo9YD","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1790333434556,"user_tz":-420,"elapsed":5275,"user":{"displayName":"Phạm Quốc","userId":"14243905189799001759"}},"outputId":"50d54cd1-7127-48f0-eec7-600e2caed125"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["[\n","  {\n","    \"image_id\": \"ARMS/000\",\n","    \"shape\": [\n","      1170,\n","      1654\n","    ],\n","    \"dtype\": \"uint8\",\n","    \"unique\": [\n","      0,\n","      255\n","    ],\n","    \"inference_sec\": 4.6547\n","  },\n","  {\n","    \"image_id\": \"ARMS/001\",\n","    \"shape\": [\n","      1170,\n","      1654\n","    ],\n","    \"dtype\": \"uint8\",\n","    \"unique\": [\n","      0,\n","      255\n","    ],\n","    \"inference_sec\": 0.2812\n","  }\n","]\n","Smoke test PASS thành công!\n"]}]},{"cell_type":"code","source":["# [Cell 11] Ghi nhận phiên bản thật của Packages (Không chứa giá trị 'default')[cite: 3]\n","def package_versions(names):\n","    out = {}\n","    for n in names:\n","        try: out[n] = importlib_metadata.version(n)\n","        except Exception: out[n] = None\n","    return out\n","\n","required_pkgs = [\n","    \"torch\", \"torchvision\", \"numpy\", \"opencv-python\", \"albumentations\",\n","    \"segmentation-models-pytorch\", \"timm\", \"huggingface-hub\", \"Pillow\",\n","    \"matplotlib\", \"pandas\", \"scipy\"\n","]\n","PACKAGES = package_versions(required_pkgs)\n","\n","# Đảm bảo không có package nào để chuỗi \"default\"[cite: 3]\n","for k, v in PACKAGES.items():\n","    if v == \"default\" or v is None:\n","        raise ValueError(f\"Package {k} chưa có phiên bản thực tế hợp lệ!\")\n