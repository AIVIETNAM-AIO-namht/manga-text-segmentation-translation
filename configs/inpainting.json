{
    "methods": {
        "classical_baseline": {
            "source_root": "outputs/segmentation/default/adaptive/"
        },
        "manga_text_segmentation": {
            "source_root": "deliverables/<RUN_ID_METHOD_A>/manga_text_segmentation/"
        },
        "comic_text_detector": {
            "source_root": "deliverables/<RUN_ID_METHOD_B>/comic_text_detector/"
        },
        "unetpp_efficientnetv2": {
            "source_root": "deliverables/<RUN_ID_METHOD_C>/unetpp_efficientnetv2/"
        }
    },
    "mask_processing": {
        "dilation": {
            "enabled": true,
            "kernel_shape": "ellipse",
            "kernel_size": [
                3,
                3
            ],
            "iterations": 1
        }
    },
    "inpaint": {
        "radius": 3,
        "algorithms": [
            "telea",
            "ns"
        ],
        "output_format": "png"
    },
    "selection": {
        "n": 5,
        "manual_artifact_flags": []
    },
    "output_root": "outputs/inpainting/"
}