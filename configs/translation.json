{
  "manifest_path": "outputs/segmentation/default/manifest.json",
  "segmentation_method": "unetpp_efficientnetv2",
  "inpainting_source": {
    "run_id": "spec003-main",
    "algorithm": "telea"
  },
  "target_language": "vi",
  "region_extraction": {
    "min_area": 50,
    "max_area": 12000,
    "merge_distance": 8,
    "crop_padding": 0,
    "reading_order": "manga",
    "polygon_epsilon": 1.0
  },
  "ocr": {
    "engine": "manga-ocr",
    "preprocessing": {
      "enabled": false,
      "grayscale": false,
      "upscale_factor": 1.0
    }
  },
  "provider": {
    "name": "vilao",
    "model": "deepseek-v4.1-flash",
    "version": null,
    "base_url": "https://api.vilao.ai/v1",
    "secret_env_var": "ANTHROPIC_AUTH_TOKEN",
    "timeout_seconds": 30.0,
    "retry": {
      "max_attempts": 3,
      "initial_backoff_seconds": 1.0,
      "max_backoff_seconds": 30.0,
      "retry_status_codes": [
        429,
        500,
        502,
        503,
        504
      ]
    },
    "failure_policy": "keep_ocr_text",
    "deterministic": false,
    "cache": {
      "enabled": true,
      "bypass": false,
      "root": "cache/translation"
    }
  },
  "rendering": {
    "font_family": "DejaVu Sans",
    "font_path": "assets/fonts/DejaVuSans.ttf",
    "fallback_font_path": null,
    "font_size": 32,
    "min_font_size": 12,
    "color": [
      0,
      0,
      0,
      255
    ],
    "stroke_width": 0,
    "stroke_fill": [
      255,
      255,
      255,
      255
    ],
    "background": null,
    "wrap": true,
    "line_spacing": 1.0,
    "align_h": "center",
    "align_v": "middle",
    "text_direction": "horizontal",
    "expansion_allowance": 0
  },
  "output_roots": {
    "translation": "outputs/translation",
    "cache": "cache/translation"
  }
}
