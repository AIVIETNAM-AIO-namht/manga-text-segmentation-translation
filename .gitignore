benchmark/dist/

# Debug scratch: root-level _*.png crops and diagnostic script output.
# Regenerate with tools/diag_*.py; never part of a deliverable.
/_*.png
deliverables/diag/
tools/*.png
tools/_diag_tmp/

.specify/
.claude/

# Local scratch: browser profiles, DOM dumps, extracted PDF/DOCX text.
# Never a deliverable; 59 MB of Edge profile data lives here.
.scratch/

# The submission staging area and its ZIP. `.drive-upload/` holds the 390
